# Counts schools per city district using the countpointsinpolygon processing tool.
 

import processing

# Input layers
districts = r"C:\Users\Deekshitha Ram\Downloads\Muenster\Muenster\Muenster_City_Districts.shp"
schools = r"C:\Users\Deekshitha Ram\Downloads\Muenster\Muenster\Schools.shp"

# Run geoprocessing tool
result = processing.run(
    "native:countpointsinpolygon",
    {
        'POLYGONS': districts,
        'POINTS': schools,
        'FIELD': 'NUMPOINTS',
        'OUTPUT': 'memory:'
    }
)

# Get output layer
output_layer = result['OUTPUT']

# Print results
for feature in output_layer.getFeatures():

    # Replace "Name" with correct district field if needed
    district_name = feature["Name"]

    # Get calculated number of schools
    count = feature["NUMPOINTS"]

    # Print result
    print(f"{district_name}: {count}")
 
