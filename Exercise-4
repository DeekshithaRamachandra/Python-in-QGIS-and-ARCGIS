# Opens the Wikipedia page of a selected city district inside a popup window using QWebView.
 
# Import required classes
from qgis.PyQt.QtCore import QUrl
from qgis.PyQt.QtWebKitWidgets import QWebView

# Get the district name from the selected feature
# Replace "Name" with the correct field if necessary
district_name = "[% \"Name\" %]"

# Create Wikipedia URL dynamically
url = "https://en.wikipedia.org/wiki/" + district_name

# Create browser window
web = QWebView()

# Load URL into the popup window
web.load(QUrl(url))

# Show popup window
web.show()
