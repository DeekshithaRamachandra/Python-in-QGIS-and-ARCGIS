from qgis.PyQt.QtWidgets import (
    QAction,
    QMessageBox,
    QFileDialog,
    QDialog
)

from qgis.PyQt import uic

from qgis.core import (
    QgsProject
)

from .profile_creator import create_pdf_profile

import os

FORM_CLASS, _ = uic.loadUiType(
    os.path.join(
        os.path.dirname(__file__),
        "forms",
        "main_dialog.ui"
    )
)


class MainDialog(QDialog, FORM_CLASS):

    def __init__(self):
        super().__init__()
        self.setupUi(self)


class MuensterCityDistrictTools:

    def __init__(self, iface):
        self.iface = iface

    def initGui(self):

        self.action = QAction(
            "Muenster City District Tools",
            self.iface.mainWindow()
        )

        self.action.triggered.connect(self.run)

        self.iface.addPluginToMenu(
            "&Muenster Tools",
            self.action
        )

    def unload(self):

        self.iface.removePluginMenu(
            "&Muenster Tools",
            self.action
        )

    def run(self):

        self.dlg = MainDialog()

        self.dlg.btnAttributes.clicked.connect(
            self.show_attributes
        )

        self.dlg.btnExport.clicked.connect(
            self.export_data
        )

        self.dlg.exec_()

    # ---------------------------------------------------
    # ATTRIBUTE QUERY
    # ---------------------------------------------------

    def show_attributes(self):

        district_layer = QgsProject.instance().mapLayersByName(
            "Muenster_City_Districts"
        )[0]

        selected = district_layer.selectedFeatures()

        if len(selected) == 0:

            QMessageBox.warning(
                None,
                "Warning",
                "Please select one district."
            )

            return

        if len(selected) > 1:

            QMessageBox.warning(
                None,
                "Warning",
                "Only one district can be selected."
            )

            return

        district = selected[0]

        QMessageBox.information(
            None,
            "District Profile",
            f"District: {district['Name']}"
        )

    # ---------------------------------------------------
    # EXPORT
    # ---------------------------------------------------

    def export_data(self):

        district_layer = QgsProject.instance().mapLayersByName(
            "Muenster_City_Districts"
        )[0]

        selected = district_layer.selectedFeatures()

        if len(selected) == 0:

            QMessageBox.warning(
                None,
                "Warning",
                "Please select a district."
            )

            return

        path, _ = QFileDialog.getSaveFileName(
            None,
            "Save CSV",
            "",
            "CSV (*.csv)"
        )

        if not path:

            QMessageBox.information(
                None,
                "Cancelled",
                "Process cancelled."
            )

            return

        with open(path, "w", encoding="utf-8") as file:

            file.write(
                "District;Area;Parcels;Schools\n"
            )

            for feature in selected:

                district_name = feature["Name"]

                area = round(
                    feature.geometry().area(),
                    2
                )

                file.write(
                    f"{district_name};{area};0;0\n"
                )

        QMessageBox.information(
            None,
            "Success",
            "CSV exported successfully."
        )


