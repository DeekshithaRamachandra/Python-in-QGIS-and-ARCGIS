# Münster GeoGuesser
# Loads district layer automatically.
# -----------------------------------------------------------

from qgis.PyQt.QtWidgets import QInputDialog, QMessageBox

from qgis.core import (
    QgsProject,
    QgsPointXY,
    QgsGeometry,
    QgsCoordinateReferenceSystem,
    QgsCoordinateTransform,
    QgsVectorLayer
)

# Get QGIS main window
parent = iface.mainWindow()


districts_path = r"C:\Users\Deekshitha Ram\Downloads\Muenster\Muenster\Muenster_City_Districts.shp"

# -----------------------------------------------------------
# Load district layer
# -----------------------------------------------------------

district_layer = QgsVectorLayer(
    districts_path,
    "Muenster_City_Districts",
    "ogr"
)

# Add layer to project
QgsProject.instance().addMapLayer(district_layer)

# -----------------------------------------------------------
# Open coordinate dialog
# -----------------------------------------------------------

sCoords, bOK = QInputDialog.getText(
    parent,
    "Coordinates",
    "Enter coordinates as latitude, longitude",
    text="51.96066,7.62476"
)

if bOK:

    try:

        # Split coordinate string
        coords = sCoords.split(",")

        latitude = float(coords[0].strip())
        longitude = float(coords[1].strip())

        # Create WGS84 point
        point_wgs84 = QgsPointXY(longitude, latitude)

        # Coordinate systems
        crs_wgs84 = QgsCoordinateReferenceSystem("EPSG:4326")
        crs_etrs89 = QgsCoordinateReferenceSystem("EPSG:25832")

        # Coordinate transformer
        transformer = QgsCoordinateTransform(
            crs_wgs84,
            crs_etrs89,
            QgsProject.instance()
        )

        # Transform coordinates
        transformed_point = transformer.transform(point_wgs84)

        # Convert to geometry
        point_geom = QgsGeometry.fromPointXY(transformed_point)

        found = False

        # Check districts
        for district in district_layer.getFeatures():

            district_geom = district.geometry()

            if district_geom.contains(point_geom):

                district_name = district["NAME"]

                QMessageBox.information(
                    parent,
                    "GeoGuesser",
                    f"The coordinates are inside {district_name}"
                )

                found = True

                break

        # Outside Münster
        if not found:

            QMessageBox.warning(
                parent,
                "GeoGuesser",
                "Coordinates are outside Münster."
            )

    except:

        QMessageBox.warning(
            parent,
            "Error",
            "Invalid coordinate format."
        )

else:

    QMessageBox.warning(
        parent,
        "GeoGuesser",
        "User cancelled."
    )
